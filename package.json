{
  "name": "kage",
  "version": "0.2.0",
  "description": "A native workbench for FastAgent agents.",
  "license": "MIT",
  "author": "the kage authors (https://github.com/fastagent-sh/kage)",
  "homepage": "https://github.com/fastagent-sh/kage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastagent-sh/kage.git"
  },
  "bugs": {
    "url": "https://github.com/fastagent-sh/kage/issues"
  },
  "keywords": [
    "fastagent",
    "ai-agents",
    "desktop-app",
    "electron",
    "agent-workbench",
    "llm"
  ],
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node -e \"require('electron')\"",
    "dev": "electron-vite dev --watch",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts' 'tests/*.test.mjs'",
    "test:smoke": "npm run build && node tests/smoke.mjs && node tests/transcript.mjs && node tests/quit.mjs",
    "test:live": "npm run build && node tests/live.mjs",
    "shots": "npm run build && node tests/shot.mjs",
    "package": "npm run build && electron-builder --mac --publish never",
    "test:package": "npm run package && node tests/packaged.mjs",
    "test:perf": "npm run build && node tests/perf.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "dependencies": {
    "@fastagent-sh/fastagent": "0.28.0",
    "undici": "^7.18.1"
  },
  "devDependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@electron/asar": "4.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/math": "^1.0.3",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-shiki": "^0.11.1",
    "streamdown": "^2.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild": false,
    "protobufjs": false,
    "@google/genai": false,
    "fsevents": false
  }
}
